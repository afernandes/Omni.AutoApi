<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>true</IsPackable>
    <PackageId>AndersonN.Omni.AutoApi.AspNetCore</PackageId>
    <Description>Auto API Controllers para ASP.NET Core: expõe Application Services (IRemoteService) como controllers MVC reais, com rota/verbo/binding convencionais.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <!-- Necessário para agrupar as ApiDescriptions por versão (um documento OpenAPI por versão). -->
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Omni.AutoApi.Abstractions\Omni.AutoApi.Abstractions.csproj" />

    <!-- O analisador de uso viaja DENTRO deste pacote: quem usa o lado servidor recebe os
         diagnósticos AUTOAPI002/003/004 sem instalar nada a mais.
         ReferenceOutputAssembly=false + PrivateAssets=all => não vira dependência do pacote;
         OutputItemType=Analyzer => também roda ao compilar este projeto (dogfooding). -->
    <ProjectReference Include="..\Omni.AutoApi.Analyzers\Omni.AutoApi.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Omni.AutoApi.Analyzers\bin\$(Configuration)\netstandard2.0\Omni.AutoApi.Analyzers.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
