<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Pacote puramente de analisador: sem dependências de runtime, lib/ ou símbolos. -->
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <IsPackable>true</IsPackable>
    <PackageId>AndersonN.Omni.AutoApi.Client.SourceGenerator</PackageId>
    <Description>Source generator que emite, em tempo de compilação, clientes HTTP tipados (XxxClient) para interfaces remotas marcadas com [AutoApiClient].</Description>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Release tracking dos diagnósticos do analisador (RS2008). -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

  <!-- Reaproveita a MESMA lógica de rota/verbo do runtime (fonte de verdade única). -->
  <ItemGroup>
    <Compile Include="..\Omni.AutoApi.Abstractions\Routing\ApiRouteBuilder.cs" Link="Shared\ApiRouteBuilder.cs" />
    <Compile Include="..\Omni.AutoApi.Abstractions\Routing\StringExtensions.cs" Link="Shared\StringExtensions.cs" />
    <Compile Include="..\Omni.AutoApi.Abstractions\Routing\RouteOptions.cs" Link="Shared\RouteOptions.cs" />
  </ItemGroup>

  <!-- Empacota o analisador no caminho que o NuGet reconhece. -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <!-- Props que expõem AutoApiRoutePrefix/AutoApiUseKebabCase ao gerador no consumidor. -->
    <None Include="build\AndersonN.Omni.AutoApi.Client.SourceGenerator.props" Pack="true" PackagePath="build" />
    <None Include="build\AndersonN.Omni.AutoApi.Client.SourceGenerator.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

</Project>
