<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Feed local com MyApi.Contracts + AutoApi.Abstractions. Em produção seria um feed
         privado (Azure Artifacts, GitHub Packages, MyGet) ou nuget.org. -->
    <add key="autoapi-local" value="..\_feed" />
  </packageSources>
</configuration>
